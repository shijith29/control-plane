# Single entry point for every command (README §11–§14).
# Requires: Docker (Compose v2) and GNU make. No local Python needed.

SHELL := /bin/bash
.DEFAULT_GOAL := help

-include .env

COMPOSE      := docker compose
TEST_COMPOSE := docker compose -f compose.test.yaml
# dev tooling container with the repo mounted, running as you (so written files stay yours)
DEV_RUN      := $(TEST_COMPOSE) run --rm --no-deps --user "$$(id -u):$$(id -g)" \
                -e HOME=/tmp -v "$(CURDIR):/app" tests

.PHONY: help up down clean logs ps demo worker psql race test check quality \
        fmt fmt-check lint typecheck security migrate migration migrate-down migrate-sql diagrams

help: ## Show this help
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk -F':.*?## ' '{printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

.env:
	@cp .env.example .env && echo "created .env from .env.example (local-only values)"

# ------------------------------------------------------------------------------- runtime

up: .env ## Build & boot everything, wait until ready
	$(COMPOSE) up -d --build
	@scripts/wait-ready.sh

down: ## Stop containers (keep data)
	$(COMPOSE) down

clean: ## Stop containers and DELETE volumes
	$(COMPOSE) down -v --remove-orphans

logs: ## Tail logs (make logs s=worker for one service)
	$(COMPOSE) logs -f --tail=100 $(s)

ps: ## Container status
	$(COMPOSE) ps

demo: ## Create a tenant and follow it to active
	@scripts/demo.sh

worker: .env ## Restart only the worker with new flags: make worker ARGS="--fail-rate=1"
	WORKER_ARGS='$(ARGS)' $(COMPOSE) up -d --no-deps --force-recreate worker
	@echo "worker restarted with: $(if $(ARGS),$(ARGS),<defaults>)"

psql: ## psql shell, or one query: make psql q="select * from tenants"
ifeq ($(strip $(q)),)
	$(COMPOSE) exec postgres psql -U "$(POSTGRES_USER)" -d "$(POSTGRES_DB)"
else
	$(COMPOSE) exec -T postgres psql -U "$(POSTGRES_USER)" -d "$(POSTGRES_DB)" -c "$(q)"
endif

race: ## Concurrency demo against the running stack
	$(COMPOSE) exec -T control-plane python scripts/race.py --base-url http://localhost:8080

# ------------------------------------------------------------------------- quality gates

test: ## Full test suite in an isolated throw-away stack
	$(TEST_COMPOSE) build tests
	$(TEST_COMPOSE) run --rm tests; rc=$$?; \
	  $(TEST_COMPOSE) down -v --remove-orphans >/dev/null 2>&1; exit $$rc

quality: ## Format check + lint + strict types + security scans
	$(TEST_COMPOSE) build tests
	$(TEST_COMPOSE) run --rm --no-deps tests scripts/quality.sh

check: quality test ## Everything CI runs

fmt: ## Format the code (writes files)
	$(DEV_RUN) sh -c "ruff format . && ruff check --fix ."

fmt-check: ## Fail if code is not formatted
	$(TEST_COMPOSE) run --rm --no-deps tests ruff format --check .

lint: ## Static analysis
	$(TEST_COMPOSE) run --rm --no-deps tests ruff check .

typecheck: ## mypy --strict
	$(TEST_COMPOSE) run --rm --no-deps tests mypy

security: ## bandit (code) + pip-audit (dependencies)
	$(TEST_COMPOSE) run --rm --no-deps tests sh -c "bandit -q -c pyproject.toml -r src && scripts/audit-deps.sh"

# ---------------------------------------------------------------------------- migrations

migrate: .env ## Apply pending migrations
	$(COMPOSE) run --rm migrate alembic upgrade head

migration: .env ## New autogenerated revision: make migration m="add region"
	@test -n "$(m)" || (echo 'usage: make migration m="message"' && exit 1)
	$(COMPOSE) up -d --wait postgres
	$(COMPOSE) run --rm --no-deps --user "$$(id -u):$$(id -g)" -v "$(CURDIR)/migrations:/app/migrations" \
	  migrate alembic revision --autogenerate -m "$(m)"

migrate-down: .env ## Roll back one revision
	$(COMPOSE) run --rm migrate alembic downgrade -1

migrate-sql: .env ## Print the migration SQL without running it
	$(COMPOSE) run --rm --no-deps migrate alembic upgrade head --sql

# ---------------------------------------------------------------------------------- docs

diagrams: ## Re-render docs/images (needs python3 + matplotlib + graphviz locally)
	cd docs && python3 diagrams/architecture.py && python3 diagrams/sequence.py \
	  && dot -Tpng -Gdpi=150 diagrams/state-machines.dot -o images/state-machines.png \
	  && dot -Tpng -Gdpi=150 diagrams/consumer-flow.dot -o images/consumer-flow.png
