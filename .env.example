# Local development values only. `make up` copies this to .env (git-ignored).
# Never put real credentials in this file.

POSTGRES_USER=controlplane
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=controlplane

RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=local-dev-only

# host ports (change if they clash with something already running)
HTTP_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

LOG_LEVEL=INFO

# worker simulator flags, e.g. --fail-rate=1 --min-delay-ms=20000
WORKER_ARGS=
